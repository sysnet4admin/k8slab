{
  "machines": [
    {
      "name": "cp11-k8s",
      "networks": [
        {
          "type": "private_network",
          "ip": "192.168.1.11"
        },
        {
          "type": "forwarded_port",
          "guest": 22,
          "host": 60011,
          "auto_correct": true,
          "id": "ssh"
        }
      ],
      "synced_folders": [
        {
          "src": "../data",
          "dst": "/vagrant",
          "disabled": true
        }
      ],
      "providers": {
        "virtualbox": {
          "customize": [
            [
              "modifyvm",
              ":id",
              "--groups",
              "/k8s-MtpCP-kubespray(github_SysNet4Admin)"
            ]
          ],
          "name": "cp11-k8s(github_SysNet4Admin)",
          "cpus": 4,
          "memory": 2048
        }
      },
      "provisions": [
        {
          "type": "file",
          "source": "auto_pass.sh",
          "destination": "auto_pass.sh"
        },
        {
          "type": "shell",
          "path": "config.sh",
          "args": [
            "3",
            "6"
          ]
        },
        {
          "type": "shell",
          "path": "cp11-k8s-console.sh",
          "args": [
            "1"
          ]
        },
        {
          "type": "shell",
          "path": "pre-kubespray.sh"
        }
      ],
      "box": "sysnet4admin/Ubuntu-k8s",
      "box_url": "https://box.kuberneteslab.dev/sysnet4admin/Ubuntu-k8s",
      "hostname": "cp11-k8s"
    },
