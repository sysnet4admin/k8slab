{
  "machines": [
    {
      "name": "cp-k8s",
      "networks": [
        {
          "type": "private_network",
          "ip": "192.168.1.10"
        },
        {
          "type": "forwarded_port",
          "guest": 22,
          "host": 60010,
          "auto_correct": true,
          "id": "ssh"
        }
      ],
      "synced_folders": [
        {
          "src": "../data",
          "dst": "/vagrant",
          "disabled": true
        }
      ],
      "providers": {
        "virtualbox": {
          "customize": [
            [
              "modifyvm",
              ":id",
              "--groups",
              "/k8s-SM(github_SysNet4Admin)"
            ]
          ],
          "name": "cp-k8s(github_SysNet4Admin)",
          "cpus": 2,
          "memory": 4096
        }
      },
      "provisions": [
        {
          "type": "shell",
          "path": "update_n_install_pkg.sh"
        }
      ],
      "box": "sysnet4admin/Ubuntu-k8s",
      "box_url": "https://box.kuberneteslab.dev/sysnet4admin/Ubuntu-k8s",
      "hostname": "cp-k8s"
    }
  ]
}
