{
  "machines": [
    {
      "name": "mk-prom-4-darksite",
      "networks": [
        {
          "type": "private_network",
          "ip": "192.168.1.231"
        },
        {
          "type": "forwarded_port",
          "guest": 22,
          "host": 60231,
          "auto_correct": true,
          "id": "ssh"
        }
      ],
      "synced_folders": [
        {
          "src": "../data",
          "dst": "/vagrant",
          "disabled": true
        }
      ],
      "providers": {
        "virtualbox": {
          "customize": [
            [
              "modifyvm",
              ":id",
              "--groups",
              "/k8s-demo-set(github_SysNet4Admin)"
            ]
          ],
          "name": "mk-prom-4-darksite",
          "cpus": 2,
          "memory": 2048
        }
      },
      "provisions": [
        {
          "type": "shell",
          "path": "minikube-build.sh",
          "args": [
            "1.23.14-00",
            "5:20.10.21~3-0~ubuntu-jammy",
            "v1.25.2"
          ]
        },
        {
          "type": "shell",
          "path": "prom.sh",
          "env": {
            "PATH": "$PATH:/usr/local/bin"
          }
        },
        {
          "type": "file",
          "source": "minikube.service",
          "destination": "/tmp/minikube.service"
        },
        {
          "type": "shell",
          "inline": "install /tmp/minikube.service /etc/systemd/system/"
        },
        {
          "type": "shell",
          "inline": "systemctl enable minikube"
        }
      ],
      "box": "sysnet4admin/Ubuntu-k8s",
      "box_url": "https://box.kuberneteslab.dev/sysnet4admin/Ubuntu-k8s",
      "hostname": "mk-prom-4-darksite"
    }
  ]
}
